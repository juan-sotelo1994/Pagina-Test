# Copia este archivo como .env y llena los valores.
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos PostgreSQL 18. Pon una contraseña larga para el usuario del panel y luego
# crea el usuario y la base con:  powershell -ExecutionPolicy Bypass -File db\crear_base.ps1
# Luego las tablas:               .venv\Scripts\python.exe db\migrar.py
# Y el primer superadministrador: .venv\Scripts\python.exe db\crear_superadmin.py
# Contraseña: python -c "import secrets; print(secrets.token_urlsafe(24))"
DATABASE_URL=postgresql://testlab_app:CAMBIAR@127.0.0.1:5432/testlab

# GLPI (opcional). Sin estos datos, la sección Tickets muestra datos de ejemplo.
# GLPI_URL: dirección de GLPI, por ejemplo https://soporte.test-lab.com
# GLPI_APP_TOKEN: Configuración > General > API > agregar cliente de la API
# GLPI_USER_TOKEN: Mis preferencias > Token de la API remota (regenerar)
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Agente de soporte (ver agente/README.md)
# AGENT_TOKEN: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=
# HOST=0.0.0.0 para que los equipos de la red lleguen al panel (127.0.0.1 = solo este PC)
HOST=127.0.0.1
# FLASK_DEBUG=0 si el panel queda accesible desde otros equipos
FLASK_DEBUG=1

# Correo (SMTP) para enviar los códigos de "¿Olvidaste tu contraseña?"
# Sin esto, los correos se guardan en app/data/correos_salientes.log (solo para probar)
# Gmail: SMTP_SERVIDOR=smtp.gmail.com, SMTP_PUERTO=587 y en SMTP_CLAVE una "contraseña de aplicación"
SMTP_SERVIDOR=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=

# Código de recuperación por SMS o WhatsApp (al celular de cada usuario). Elige un proveedor:
#   MENSAJES_PROVEEDOR=twilio     -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN y TWILIO_DESDE
#                                    (SMS: +15017122661 · WhatsApp: whatsapp:+14155238886)
#   MENSAJES_PROVEEDOR=whatsapp   -> WhatsApp Cloud API de Meta: WHATSAPP_TOKEN, WHATSAPP_TELEFONO_ID y
#                                    WHATSAPP_PLANTILLA (plantilla de «Autenticación» aprobada), WHATSAPP_IDIOMA=es
# Sin proveedor, los mensajes quedan en app/data/mensajes_salientes.log
MENSAJES_PROVEEDOR=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DESDE=
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=es
