# Copia este archivo como .env y llena los valores.
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_PASSWORD_HASH: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu-contraseña'))"
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Agente de soporte (ver agente/README.md)
# AGENT_TOKEN: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=
# HOST=0.0.0.0 para que los equipos de la red lleguen al panel (127.0.0.1 = solo este PC)
HOST=127.0.0.1
# FLASK_DEBUG=0 si el panel queda accesible desde otros equipos
FLASK_DEBUG=1
