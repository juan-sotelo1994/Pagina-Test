# Copia este archivo como .env y llena los valores.
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_PASSWORD_HASH: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu-contraseña'))"
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# GLPI (opcional). Sin estos datos, la sección Tickets muestra datos de ejemplo.
# GLPI_URL: dirección de GLPI, por ejemplo https://soporte.test-lab.com
# GLPI_APP_TOKEN: Configuración > General > API > agregar cliente de la API
# GLPI_USER_TOKEN: Mis preferencias > Token de la API remota (regenerar)
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
